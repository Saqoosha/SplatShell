+// Label for a physical key code as printed on the user's keyboard. Bindings by
+// code keep their position on any layout, so on Dvorak 'KeyW' is the key
+// labelled ','. A host app can supply the current layout's labels as
+// window.keyboardLayoutLabels ({ KeyW: ',' }); without it, QWERTY is assumed.
+const keyCodeLabel = (code: string): string => {
+    const labels = (window as { keyboardLayoutLabels?: Record<string, string> }).keyboardLayoutLabels;
+    const label = labels?.[code] ?? punctuationLabels[code];
+    if (label) return label.toUpperCase();
+    return code.startsWith('Key') ? code.slice(3) : code;
+};
+
+const punctuationLabels: Record<string, string> = {
+    Comma: ',',
+    Period: '.',
+    Quote: "'",
+    Semicolon: ';',
+    Slash: '/'
+};
